# Manifest do app instalável (PWA)
AddType application/manifest+json .webmanifest

RewriteEngine On
RewriteBase /

# Raiz: shell atual do app (index.csr.html). Pastas pré-renderizadas
# (/home, /login...) só têm index.html, então ele é o segundo da lista.
DirectoryIndex index.csr.html index.html

# A API (/api) tem seu próprio .htaccess e não passa por aqui
RewriteRule ^api(/|$) - [L]

# Arquivos e pastas que existem (js, css, imagens, rotas pré-renderizadas)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Demais rotas do Angular (receita/..., perfil/...) → shell do app
RewriteRule ^ index.csr.html [L]
